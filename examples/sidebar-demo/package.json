{
  "name": "dsh-reference-render-sidebar-demo",
  "version": "0.1.1",
  "description": "Demo content-contributor plugin for dsh-reference-render: resource sidebar tab (frame-stream provider + useResource body), hover preview contribution, and reference/open takeover. Acceptance/demo material.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popingalex/dsh-reference-render.git",
    "directory": "examples/sidebar-demo"
  },
  "bugs": {
    "url": "https://github.com/popingalex/dsh-reference-render/issues"
  },
  "homepage": "https://github.com/popingalex/dsh-reference-render#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "src",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-resources"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-alpha.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown > /dev/null"
  },
  "devDependencies": {
    "tsdown": "^0.22.2"
  }
}
