{
  "name": "dsh-reference-sidebar-demo",
  "version": "0.1.1",
  "description": "Demo content-contributor plugin for dsh-reference: resource sidebar tab (frame-stream provider + useResource body), hover preview contribution, and reference/open takeover. Acceptance/demo material.",
  "license": "MIT",
  "type": "module",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-resources"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-alpha.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "tsdown": "^0.22.2"
  }
}